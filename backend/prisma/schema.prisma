generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MedicalHistory {
  id            Int        @id @default(autoincrement())
  userId        Int?
  condition     String
  diagnosisDate DateTime
  medications   String?
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now())
  user          User       @relation(fields: [userId], references: [id])
  symptoms      Symptoms[]
}

model Allergies {
  id       Int      @id @default(autoincrement())
  userId   Int
  trigger  String
  severity Int
  reaction String
  notes    String?
  date     DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
}

model Symptoms {
  id          Int             @id @default(autoincrement())
  userId      Int
  name        String
  severity    Int
  duration    String
  notes       String?
  date        DateTime        @default(now())
  diagnosisId Int?
  symptoms    String[]
  diagnosis   MedicalHistory? @relation(fields: [diagnosisId], references: [id])
  user        User            @relation(fields: [userId], references: [id])
}

model Hospital {
  id              Int      @id @default(autoincrement())
  name            String
  address         String
  region          String
  latitude        Float?
  longitude       Float?
  phone           String?
  specializations String[]
}

model User {
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @default(now())
  lastLoginAt           DateTime?
  username              String?          @unique
  password              String?
  location              String?
  age                   Int?
  gender                String?
  id                    Int              @id @default(autoincrement())
  email                 String?          @unique
  preferredNotification String @default("email")
  reminderFrequency     Int @default(3)
  snoozeUntil           DateTime?
  lastNotifiedAt        DateTime?
  height                Int?
  weight                Int?
  preExistingConditions String[]
  allergies             Allergies[]
  medicalHistory        MedicalHistory[]
  symptoms              Symptoms[]
}

model Conditions {
  id             Int      @id @default(autoincrement())
  condition      String
  symptoms       String[]
  symptomweights Json
}

model Precautions {
  id          Int      @id @default(autoincrement())
  condition   String
  precautions String[]
}
